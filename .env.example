# Copy to .env for local development. .env is gitignored and is NOT uploaded to EAS.
# EAS builds get their keys from eas.json (build.<profile>.env).

# RevenueCat Test Store key (starts with test_). Used ONLY in __DEV__ builds, on iOS and Android.
# Release builds refuse test_ keys.
EXPO_PUBLIC_RC_TEST_STORE_KEY=

# Optional: platform public SDK keys for local sandbox testing (same values as eas.json).
# EXPO_PUBLIC_RC_API_KEY=appl_...
# EXPO_PUBLIC_RC_GOOGLE_API_KEY=goog_...

EXPO_PUBLIC_AMPLITUDE_API_KEY=

# Optional: shown on the paywall (Apple 3.1.2). Defaults: Apple standard EULA / hidden.
# EXPO_PUBLIC_TERMS_URL=
# EXPO_PUBLIC_PRIVACY_URL=
